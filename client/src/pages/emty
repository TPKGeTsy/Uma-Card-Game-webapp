import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { useNavigate, useLocation } from 'react-router-dom'; // ✅ เพิ่ม useLocation
import { TRACKS } from '../data/track';
import BattleRace from './BattleRace';

// Phase Constants
const PHASES = { LOAD: 0, SETUP: 1, DECK_SELECT: 2, ALLOCATE: 3, RACE: 4, RESULT: 5 };

// ✅ 1. Helper Function: ฟังก์ชันสุ่มของจาก Array
const getRandomItems = (arr, count) => {
    if (!arr || arr.length === 0) return [];
    const shuffled = [...arr].sort(() => 0.5 - Math.random());
    return shuffled.slice(0, count);
};

// ==========================================
// 🧩 PHASE 1: BATTLE SETUP
// ==========================================
function BattleSetup({ onConfirmTeam, trackInfo, triggerPoints, inventoryHorses, inventoryActions }) {
    const [myTeam, setMyTeam] = useState([]);

    const STRATEGIES = {
        RUNNER: { label: 'นำ (Runner)', color: '#ff9800' },
        BETWEENER: { label: 'กลาง (Betweener)', color: '#2196f3' },
        CHASER: { label: 'เสียบ (Chaser)', color: '#9c27b0' }
    };

    const toggleSelectHorse = (horse) => {
        const exists = myTeam.find(h => h._id === horse._id);
        if (exists) {
            setMyTeam(myTeam.filter(h => h._id !== horse._id));
        } else if (myTeam.length < 3) {
            setMyTeam([...myTeam, { ...horse, strategy: 'BETWEENER' }]);
        }
    };

    const changeStrategy = (horseId, newStrat) => {
        setMyTeam(prev => prev.map(h => h._id === horseId ? { ...h, strategy: newStrat } : h));
    };

    if (!trackInfo) return <div style={{color:'white', textAlign:'center'}}>Loading...</div>;

    return (
        <div style={setupStyles.container}>
            <div style={setupStyles.leftPanel}>
                <div style={setupStyles.trackCard}>
                    <img src={trackInfo.image} style={setupStyles.trackImg} onError={(e)=>e.target.src='https://placehold.co/600'}/>
                    <div style={setupStyles.trackOverlay}>
                        <h2>{trackInfo.name}</h2>
                        <div style={{color:'#ffeb3b'}}>🚩 {trackInfo.distance}m | 🌦️ {trackInfo.weather}</div>
                    </div>
                </div>
                <div style={setupStyles.trackInfoBox}>
                     <div style={{color:'#d32f2f', fontWeight:'bold', border:'1px dashed red', padding:'10px', borderRadius:'8px', background:'rgba(255, 235, 238, 0.9)'}}>
                        ⚡ จุดใช้สกิล (Trigger Points)<br/>
                        <span style={{fontSize:'1.1rem'}}>{triggerPoints.join('m ➜ ')}m</span>
                    </div>
                </div>
            </div>
            <div style={setupStyles.rightPanel}>
                <div style={setupStyles.teamSlotsContainer}>
                    <h3 style={{color:'white', margin:'0 0 10px 0'}}>จัดทีม ({myTeam.length}/3)</h3>
                    <div style={setupStyles.slotsFlex}>
                        {[0,1,2].map(i => {
                            const h = myTeam[i];
                            return <div key={i} style={setupStyles.slotBox}>
                                {h ? (
                                    <>
                                        <img src={h.image} style={setupStyles.slotImg} />
                                        <button onClick={()=>toggleSelectHorse(h)} style={setupStyles.removeBtn}>✕</button>
                                        <div style={setupStyles.slotNameBox}>{h.name}</div>
                                        <div style={{width:'90%', margin:'5px auto'}}>
                                            <select value={h.strategy} onChange={(e)=>changeStrategy(h._id, e.target.value)} style={{...setupStyles.strategySelect, borderTop: `3px solid ${STRATEGIES[h.strategy].color}`}}>
                                                {Object.keys(STRATEGIES).map(k => <option key={k} value={k}>{STRATEGIES[k].label}</option>)}
                                            </select>
                                        </div>
                                    </>
                                ) : <div style={{fontSize:'2rem', color:'#555', marginTop:'auto', marginBottom:'auto'}}>+</div>}
                            </div>
                        })}
                    </div>
                    <button style={{...setupStyles.confirmBtn, opacity: myTeam.length===3?1:0.5}} onClick={()=>onConfirmTeam(myTeam)} disabled={myTeam.length!==3}>CONFIRM TEAM 🚀</button>
                </div>
                <div style={setupStyles.inventoryContainer}>
                    <h4 style={{color:'#aaa', margin:'0 0 10px 0'}}>เลือกม้าเข้าคอก</h4>
                    <div style={setupStyles.grid}>
                        {inventoryHorses.map(h => {
                            const selected = myTeam.find(t=>t._id===h._id);
                            return (
                                <div key={h._id} onClick={()=>toggleSelectHorse(h)} style={{...setupStyles.card, border: selected?'2px solid #00e676':'1px solid #444', opacity: selected?0.6:1}}>
                                    <img src={h.image} style={setupStyles.cardImg} onError={(e)=>e.target.src='https://placehold.co/100'}/>
                                    <div style={{fontSize:'0.7rem', color:'white', marginTop:'2px', whiteSpace:'nowrap', overflow:'hidden', textOverflow:'ellipsis'}}>{h.name}</div>
                                </div>
                            )
                        })}
                    </div>
                </div>
            </div>
        </div>
    );
}

// ==========================================
// 🎴 PHASE 2: DECK SELECT
// ==========================================
function BattleDeckSelect({ inventoryActions, onDeckComplete }) {
    const [selectedCards, setSelectedCards] = useState([]);
    const MAX = 6;
    const toggle = (c) => selectedCards.find(s=>s._id===c._id) ? setSelectedCards(p=>p.filter(s=>s._id!==c._id)) : (selectedCards.length<MAX && setSelectedCards(p=>[...p,c]));

    return (
        <div style={{textAlign:'center', color:'white', maxWidth:'1000px', margin:'0 auto'}}>
            <h2>🎴 เลือกการ์ด Action ({selectedCards.length}/{MAX})</h2>
            <button onClick={()=>onDeckComplete(selectedCards)} disabled={!selectedCards.length} style={{...setupStyles.confirmBtn, width:'200px', marginBottom:'20px'}}>CONFIRM DECK ✅</button>
            <div style={{display:'flex', flexWrap:'wrap', justifyContent:'center', gap:'15px', maxHeight:'60vh', overflowY:'auto'}}>
                {inventoryActions.map(c => {
                    const active = selectedCards.find(s=>s._id===c._id);
                    return (
                        <div key={c._id} onClick={()=>toggle(c)} style={{...setupStyles.card, width:'130px', height:'200px', border: active?'2px solid #00e676':'1px solid #444', background: active?'#1e3a2a':'#252525', transform: active?'scale(1.05)':'scale(1)'}}>
                            <div style={{fontSize:'0.6rem', background: active?'#00e676':'#333', color: active?'black':'white', borderRadius:'4px', marginBottom:'5px'}}>{c.type}</div>
                            <img src={c.image} style={{width:'100%', height:'80px', objectFit:'cover', borderRadius:'4px'}} onError={(e)=>e.target.src='https://placehold.co/100'}/>
                            <div style={{fontSize:'0.8rem', fontWeight:'bold', color:'white', margin:'5px 0'}}>{c.name}</div>
                            <div style={{fontSize:'0.6rem', color:'#aaa'}}>{c.description || "No Desc"}</div>
                            {active && <div style={{marginTop:'auto', color:'#00e676', fontWeight:'bold'}}>SELECTED</div>}
                        </div>
                    )
                })}
            </div>
        </div>
    );
}

// ==========================================
// 🛠️ PHASE 3: ALLOCATE
// ==========================================
function BattleAllocate({ team, deckCards, onAllocateComplete }) {
    const [allocs, setAllocs] = useState({});
    const [selCard, setSelCard] = useState(null);
    useEffect(() => { const init={}; team.forEach(h=>init[h._id]=[]); setAllocs(init); }, [team]);

    const clickHorse = (h) => { 
        if(selCard) { 
            setAllocs(p=>({...p, [h._id]:[...p[h._id], selCard]})); 
            setSelCard(null); 
        } 
    };
    
    return (
        <div style={{textAlign:'center', color:'white', maxWidth:'1000px', margin:'0 auto'}}>
            <h2>🛠️ ติดตั้งการ์ดให้ม้า</h2>
            <div style={{display:'flex', justifyContent:'center', gap:'20px', marginBottom:'20px', flexWrap:'wrap'}}>
                {team.map(h => (
                    <div key={h._id} onClick={()=>clickHorse(h)} style={{border: selCard?'2px dashed #00e676':'1px solid #444', padding:'15px', borderRadius:'15px', width:'250px', background:'#222', cursor: selCard?'pointer':'default'}}>
                        <img src={h.image} style={{width:'100px', height:'100px', borderRadius:'50%', border:`3px solid ${h.strategy==='RUNNER'?'#ff9800':h.strategy==='CHASER'?'#9c27b0':'#2196f3'}`}} onError={(e)=>e.target.src='https://placehold.co/100'}/>
                        <div style={{fontWeight:'bold', margin:'10px 0'}}>{h.name}</div>
                        <div style={{background:'#111', padding:'5px', borderRadius:'5px', minHeight:'50px', display:'flex', gap:'5px', flexWrap:'wrap', justifyContent:'center'}}>
                            {allocs[h._id]?.length===0 && <span style={{fontSize:'0.7rem', color:'#555'}}>Empty</span>}
                            {allocs[h._id]?.map((c,i)=><div key={i} style={{fontSize:'0.6rem', background:'#e91e63', padding:'3px 6px', borderRadius:'4px', color:'white'}}>{c.name}</div>)}
                        </div>
                    </div>
                ))}
            </div>
            <div style={{background:'#222', padding:'20px', borderRadius:'15px', border:'1px solid #444'}}>
                <h4 style={{margin:'0 0 10px 0'}}>Your Hand</h4>
                <div style={{display:'flex', gap:'10px', justifyContent:'center', flexWrap:'wrap'}}>
                    {deckCards.map(c => {
                        const used = Object.values(allocs).flat().find(x=>x._id===c._id);
                        return (
                            <button key={c._id} disabled={used} onClick={()=>setSelCard(c)} 
                                style={{
                                    padding:'10px', width:'100px', height:'120px', borderRadius:'8px', cursor:'pointer',
                                    opacity:used?0.3:1, border: selCard?._id===c._id?'2px solid #00e676':'1px solid #555',
                                    background: selCard?._id===c._id ? '#1e3a2a' : '#333', color:'white'
                                }}>
                                <div style={{fontSize:'0.8rem', fontWeight:'bold'}}>{c.name}</div>
                                <div style={{fontSize:'0.7rem', color:'#00e676'}}>{c.effectType}</div>
                            </button>
                        )
                    })}
                </div>
            </div>
            {/* ✅ ปุ่มกดเพื่อเริ่มแข่ง (จะไปเรียกฟังก์ชันสร้าง Enemy) */}
            <button onClick={()=>onAllocateComplete(allocs)} style={{...setupStyles.confirmBtn, marginTop:'30px', width:'300px'}}>START RACE 🏁</button>
        </div>
    );
}

// ==========================================
// 🎮 MAIN BATTLE
// ==========================================
function Battle() {
  const navigate = useNavigate();
  const location = useLocation();
  const token = localStorage.getItem('token');
  
  // 1. รับ Enemy จาก Arena (ถ้ามี)
  const arenaEnemy = location.state?.enemyTeam || []; 
  
  // 2. State เก็บศัตรูที่จะใช้แข่งจริง
  const [finalEnemyTeam, setFinalEnemyTeam] = useState([]);

  const [phase, setPhase] = useState(PHASES.LOAD);
  const [trackInfo, setTrackInfo] = useState(null);
  const [triggerPoints, setTriggerPoints] = useState([]);
  const [myInventoryHorses, setMyInventoryHorses] = useState([]);
  const [myInventoryActions, setMyInventoryActions] = useState([]); 
  const [myTeam, setMyTeam] = useState([]);
  const [selectedDeck, setSelectedDeck] = useState([]);

  useEffect(() => {
    fetchUserData();
    randomizeTrack();
  }, []);

  // 🔥 3. ฟังก์ชันสร้างศัตรู (Random Logic)
  const generateEnemies = () => {
      // A. ถ้ามาจาก Arena ใช้ทีมนั้นเลย ไม่ต้องสุ่ม
      if (arenaEnemy.length > 0) {
          setFinalEnemyTeam(arenaEnemy);
          return;
      }

      // B. ถ้าเล่นปกติ -> สุ่มจาก DB (Inventory ที่โหลดมา)
      // หาม้าที่ไม่ซ้ำกับทีมเรา
      const myTeamIds = myTeam.map(h => h._id);
      const availableHorses = myInventoryHorses.filter(h => !myTeamIds.includes(h._id));
      
      // สุ่มหยิบ 3 ตัว (ถ้าเหลือไม่ถึง 3 ก็เอาเท่าที่มี)
      const randomHorses = getRandomItems(availableHorses, 3);

      // ใส่สกิลให้มัน (สุ่ม 2 ใบจาก Inventory Actions)
      const enemiesWithSkills = randomHorses.map(horse => ({
          ...horse,
          // กันเหนียวเผื่อไม่มี stats
          stats: horse.stats || { speed: 600, stamina: 600, power: 600, guts: 600, wisdom: 600 },
          // สุ่มสกิลใส่ให้ 2 ใบ
          equippedCards: getRandomItems(myInventoryActions, 2).map(skill => ({ 
              ...skill, 
              isUsed: false 
          }))
      }));

      setFinalEnemyTeam(enemiesWithSkills);
  };

  const fetchUserData = async () => {
    try {
        if (!token) return navigate('/login');
        const res = await axios.get('http://localhost:5000/api/user/inventory', { headers: { Authorization: `Bearer ${token}` } });
        setMyInventoryHorses(res.data.filter(i => i.cardId?.type === 'HORSE').map(i => i.cardId));
        setMyInventoryActions(res.data.filter(i => i.cardId?.type === 'ACTION').map(i => i.cardId));
        setPhase(PHASES.SETUP);
    } catch (err) { console.error("Load Error:", err); }
  };

  const randomizeTrack = () => {
      const randomIndex = Math.floor(Math.random() * TRACKS.length);
      const selectedTrack = TRACKS[randomIndex];
      const weather = selectedTrack.weatherOptions?.[Math.floor(Math.random()*selectedTrack.weatherOptions.length)] || "Sunny";
      setTrackInfo({ ...selectedTrack, weather });
      
      let landmarks = selectedTrack.landmarks || [];
      if (landmarks.length > 0) {
          const minPoints = 3;
          const maxPoints = Math.min(5, landmarks.length); 
          const count = Math.floor(Math.random() * (maxPoints - minPoints + 1)) + minPoints;
          const picked = [...landmarks].sort(() => 0.5 - Math.random()).slice(0, count).sort((a, b) => a.distance - b.distance);
          const variedPoints = picked.map(p => Math.max(0, Math.min(p.distance + (Math.floor(Math.random() * 101) - 50), selectedTrack.distance)));
          setTriggerPoints(variedPoints);
      } else {
          setTriggerPoints([500, 1000, 1500]); 
      }
  };

  return (
    <div style={{minHeight:'100vh', background:'#111', padding:'20px', fontFamily:'Arial'}}>
        {phase === PHASES.SETUP && (
            <BattleSetup onConfirmTeam={(t) => { setMyTeam(t); setPhase(PHASES.DECK_SELECT); }} trackInfo={trackInfo} triggerPoints={triggerPoints} inventoryHorses={myInventoryHorses} inventoryActions={myInventoryActions} />
        )}
        
        {phase === PHASES.DECK_SELECT && (
            <BattleDeckSelect inventoryActions={myInventoryActions} onDeckComplete={(d) => { setSelectedDeck(d); setPhase(PHASES.ALLOCATE); }} />
        )}

        {phase === PHASES.ALLOCATE && (
            <BattleAllocate team={myTeam} deckCards={selectedDeck} onAllocateComplete={(a) => {
                // 1. เซฟทีมเรา
                setMyTeam(myTeam.map(h => ({ ...h, equippedCards: a[h._id] || [], finalStats: { ...h.stats } })));
                
                // 🔥 2. เรียกฟังก์ชันสุ่มศัตรู ก่อนเริ่มแข่ง
                generateEnemies();
                
                // 3. ไปหน้าแข่ง
                setPhase(PHASES.RACE);
            }} />
        )}

        {phase === PHASES.RACE && (
            <BattleRace 
                team={myTeam} 
                trackInfo={trackInfo} 
                enemyTeam={finalEnemyTeam} // ✅ ส่งทีมที่สุ่มได้ไปให้ Engine
                triggerPoints={triggerPoints} 
            />
        )}

        {phase === PHASES.LOAD && <div style={{color:'white', textAlign:'center', marginTop:'50px'}}>กำลังเตรียมสนามแข่ง... 🏇</div>}
    </div>
  );
}

